---
layout: layouts/base.njk
title: Blog — Zafar Mahmood
description: "Notes on data engineering: pipelines, warehouses, and infrastructure, by Zafar Mahmood."
navActive: blog
permalink: /blog/
---
<main class="blog-main">

  <section class="blog-hero">
    <div class="hero__eyebrow">
      <span class="pulse-dot" aria-hidden="true"></span>
      /var/log/blog — {{ collections.posts.length }} posts
    </div>
    <h1 class="blog-hero__title">Writing</h1>
    <p class="blog-hero__desc">Long-form notes on pipelines, warehouses, and the failures that taught me the most.</p>
  </section>

  <div class="tag-cloud">
    {% for item in collections.tagCounts %}
    <a href="/blog/tags/{{ item.tag | slug }}/" class="tag-count">{{ item.tag }} <span class="tag-count__n">{{ item.count }}</span></a>
    {% endfor %}
  </div>

  {% for group in collections.postsByYear %}
  <h2 class="blog-year">
    {{ group.year }}
    <span class="blog-year__count">{{ group.posts.length }} article{% if group.posts.length != 1 %}s{% endif %}</span>
  </h2>
  <hr class="blog-year-rule">
  <div class="timeline-grid">
    {% for post in group.posts %}
    <article class="timeline-item">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <time>{{ post.date | dateShort }}</time>
    </article>
    {% endfor %}
  </div>
  {% endfor %}

</main>

<footer class="footer">
  <span>© 2026 Zafar Mahmood</span>
  <span class="footer__dot">·</span>
  <span><a href="/" class="inline-link">Back to home</a></span>
</footer>
