---
layout: layouts/base.njk
navActive: blog
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/blog/tags/{{ tag | slug }}/"
eleventyComputed:
  title: "Posts tagged “{{ tag }}” — Zafar Mahmood"
  description: "Posts tagged {{ tag }} on Zafar Mahmood's blog."
---
<main class="blog-main">

  <section class="blog-hero">
    <div class="hero__eyebrow">
      <span class="pulse-dot" aria-hidden="true"></span>
      /var/log/blog — tag: {{ tag }}
    </div>
    <h1 class="blog-hero__title">{{ tag }}</h1>
    <p class="blog-hero__desc"><a href="/blog/" class="inline-link">← All posts</a></p>
  </section>

  <div class="post-list">
    {% for post in collections.posts | reverse %}
    {% if tag in post.data.tags %}
    <article class="post-list__item">
      <div class="post__meta">
        <time>{{ post.data.date | dateDisplay }}</time>
        <span class="post__meta-dot">·</span>
        <span class="post__readtime">{{ post.templateContent | readingTime }} min read</span>
      </div>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p>{{ post.data.description }}</p>
      <a href="{{ post.url }}" class="post-list__link">Read more →</a>
    </article>
    {% endif %}
    {% endfor %}
  </div>

</main>

<footer class="footer">
  <span>© 2026 Zafar Mahmood</span>
  <span class="footer__dot">·</span>
  <span><a href="/" class="inline-link">Back to home</a></span>
</footer>
