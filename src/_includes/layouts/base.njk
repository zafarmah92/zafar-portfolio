<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<div class="grid-bg" aria-hidden="true"></div>

<aside class="sidebar">
  <div class="sidebar__profile">
    <div class="sidebar__avatar">
      <img src="/avatar.jpg" alt="Zafar Mahmood">
    </div>
    <div class="sidebar__id">
      <span class="sidebar__name">Zafar Mahmood</span>
      <span class="sidebar__role">Data Engineer</span>
    </div>
  </div>

  <nav class="sidebar__nav">
    <a href="/" class="sidebar__link{% if navActive == 'home' %} active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Home
    </a>
    <a href="/#projects" class="sidebar__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Projects
    </a>
    <a href="/blog/" class="sidebar__link{% if navActive == 'blog' %} active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
      Blog
    </a>
    <a href="/#videos" class="sidebar__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
      Videos
    </a>
    <a href="/#contact" class="sidebar__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>
      Contact
    </a>
  </nav>

  <div class="sidebar__footer">
    <a href="/Zafar_Mahmood_CV.pdf" target="_blank" rel="noopener" class="btn btn--primary sidebar__cv">Download CV ↗</a>
    <a href="https://github.com/zafarmah92/" target="_blank" rel="noopener" class="sidebar__social">GitHub ↗</a>
  </div>
</aside>

<div class="page">
{{ content | safe }}
</div>

</body>
</html>
